{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/pricing.js": {
      "maxDuration": 150
    },
    "api/market-data.js": {
      "maxDuration": 300
    },
    "api/market-history.js": {
      "maxDuration": 20
    },
    "api/strategies.js": {
      "maxDuration": 10
    },
    "api/auth.js": {
      "maxDuration": 10
    },
    "api/broker.js": {
      "maxDuration": 15
    },
    "api/copy-trading.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/public/(.*)",
      "destination": "/public/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
