# Configure these in Vercel Project Settings -> Environment Variables.
# Optional: set this only when a separate FastAPI pricing service is deployed.
PRICING_SERVICE_URL=https://pricing.example.com
# Use the same long random value on Vercel and on the pricing container.
PRICING_API_KEY=replace-with-a-long-random-secret
# Optional: maximum paths for the built-in Vercel CPU fallback (default 10,000,000).
PRICING_FALLBACK_MAX_PATHS=10000000
# Required to enable server-side Twelve Data real-time market ticks.
TWELVE_DATA_API_KEY=replace-with-your-twelve-data-api-key
# Keep at 1 for Twelve Data Basic trial connections.
MARKET_DATA_MAX_CONNECTIONS=1
